{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console",
      "Serilog.Sinks.MSSqlServer"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Error",
        "System": "Error"
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.Authentication": "Debug"
    },
    "WriteTo": [

      {
        "Name": "File",
        "Args": {
          "path": "Logs/SB-Security-Service.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff}] [{Level}] ({ThreadId}) <{SourceContext}> {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/SB-Security-Service.json",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff}] [{Level}] ({ThreadId}) <{SourceContext}> {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Server=SREE-PC\\MSSQL16;Database=SecurityDB;User ID=sa;Password=sa123;Encrypt=True;TrustServerCertificate=true",
          "tableName": "SecurityLog",
          "autoCreateSqlTable": true
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithExceptionDetails", "WithMachineName", "WithThreadId" ]
  },
  "IsConnectionStrInAzureVault": false,
  "KeyVaultUri": "https://sberpkeyvault.vault.azure.net/",
  "AppSettings": {
    "AppDB": "SqlServer",
    "ConnectionStrings": {
      "SCSqlConnectionString": "Server=SREE-PC\\MSSQL16;Database=SecurityDB;User ID=sa;Password=sa123;Encrypt=True;TrustServerCertificate=true",
      "SCOracleConnectionString": "#",
      "SCOdbcConnectionString": "#",
      "SCOledbConnectionString": "#",
      "SCDefaultConnectionString": "Server=SREE-PC\\MSSQL16;Database=SecurityDB;User ID=sa;Password=sa123;Encrypt=True;TrustServerCertificate=true"
    },
    "ConnectionProvider": "Microsoft.Data.SqlClient",
    "Expires": 10, //Expires in min
    "AccessTokenExpirationMinutes": 2,
    "RefreshTokenExpirationDays": 1, //Sliding: a refresh token unused for this long expires
    "RefreshTokenSessionLifetimeDays": 7, //Absolute: a login session ends after this, however often it is refreshed
    "JWT": {
      "Key": "aKd83jFhLzqP9s3yBnW6XpG7VzRjL2XmH5tW4CvF7Ds9JcX2NrQ8TyH6MzKb9VhP",
      "Issuer": "https://localhost:44357",
      "Audience": "https://localhost:44357",
      "Subject": "JWTServiceAccessToken"
    },
    "MaxNumberOfFailedAttempts": 3,
    "BlockMinutes": 1,
    "EmailConfiguration": {
      "From": "sreemonta.bhowmik@yahoo.com",
      "Name": "Sreemonta",
      "Host": "smtp.mail.yahoo.com",
      "Port": 465,
      "Username": "sreemonta.bhowmik",
      "Password": "****************"
    },
    "IsUserDelate": true
  },
  "PhotoStorage": {
    // Root folder of uploaded photos. Empty = the Pictures folder of the account running the service
    // (Windows: This PC > Pictures). Production: set an absolute path or mounted share in
    // appsettings.Production.json, e.g. "D:\\SBERP\\Photos" or "/var/sberp/photos",
    // or the environment variable PhotoStorage__RootPath (Azure App Service: Configuration > App settings).
    "RootPath": "",
    "UserProfileFolder": "userprofile",
    "EmployeeFolder": "employee",
    "MaxFileSizeKB": 2048
  },
  "RedisSettings": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "SBERP_Security_",
    "MenuCacheExpiryMinutes": 30,
    "MenuCacheSlidingExpiryMinutes": 10
  },
  "RabbitMq": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "sberp.events",
    "OnboardedQueue": "security.employee.onboarded",
    "OffboardedQueue": "security.employee.offboarded",
    "DeadLetterExchange": "sberp.events.dlx"
  },
  "Offboarding": {
    "TimeZoneId": "Arabian Standard Time",
    "SweepMinutes": 5
  },
  "Onboarding": {
    "DefaultRoleId": "10A9E9E7-CB24-4816-9B94-9DB275A40EDD",
    "SystemActorProfileId": "C047D662-9F0E-4358-B323-15EC3081312C",
    "LoginUrl": "http://localhost:4200/",
    "SendWelcomeEmail": false,
    "EmailPollSeconds": 30,
    "EmailMaxAttempts": 5
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "https://localhost:4200",
    "http://localhost:4200",
    "https://localhost:44357"
  ],
  "SecurityHeaders": {
    "ContentSecurityPolicy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'",
    "XContentTypeOptions": "nosniff",
    "XFrameOptions": "DENY",
    "ReferrerPolicy": "no-referrer",
    "PermissionsPolicy": "camera=(), microphone=(), geolocation=()",
    "StrictTransportSecurity": "max-age=31536000; includeSubDomains"
  },
  "AllowedHttpVerbs": [ "GET", "POST", "PUT", "DELETE", "HEAD", "OPTIONS" ]
}
